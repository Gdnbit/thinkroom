# 误命名的 pip 输出（曾因 `pip install xxx==1.0.1` 落到 cwd）
apps/backend/1.0.1

# 开发期素材 & 发布构建产物（需要分享时走单独归档）
test_inbox/
release/

# 本地验收语料包含用户提供的大文件，仅保留在工作机和恢复包中。
tests/test_decoment/

# 待删除审批区只版本化清单；候选文件继续原位保留，等待人工审批。
_pending_delete_review/*
!_pending_delete_review/README.md

# Docker
.docker/

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# Alembic: versions/ 必须入库（fresh clone / CI / prod 都依赖 revision 文件）
