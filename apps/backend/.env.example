# ============================================================
# ThinkRoom — 环境变量配置示例
# 仅复制非秘密配置；真实凭据由自己的凭据管理器注入后端进程
# cp .env.example .env
# ============================================================
# 最后更新：2026-04-10
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
# 本地开发（SQLite，无需安装 PostgreSQL）
DATABASE_URL=sqlite:///./dev.db
# Docker / 生产（PostgreSQL + pgvector）
# DATABASE_URL=postgresql://agent_user:agent_pass@localhost:5432/agent_db

# ── Redis（可选，离线自动降级到内存字典）─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenRouter 统一中转 ───────────────────────────────────
# 所有 LLM 调用通过 OpenRouter 路由，留空则使用 Mock 模式
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── 模块级专用 API Keys（可选，留空自动回退 OPENROUTER_API_KEY）
# 优点：独立统计成本、单模块故障可快速替换而不影响其他模块
BRIEFING_API_KEY=
FUSION_API_KEY=
EXTRACTION_API_KEY=
COMMITTEE_API_KEY_A=
COMMITTEE_API_KEY_B=
COMMITTEE_API_KEY_C=
SPEAKER_API_KEY=
STRATEGY_API_KEY=
EMBEDDING_API_KEY=

# ── 模型分工配置 ─────────────────────────────────────────────
# 已内置合理默认值（config.py），通常无需覆盖。
# 如确需覆盖，取消注释对应行：
# BRIEFING_MODEL=anthropic/claude-sonnet-4.6
# BRIEFING_MAX_TOKENS=2500
# BRIEFING_GENERAL_MAX_TOKENS=1400
# SELECTED_SCOPE_DIRECT_CLAIM_LIMIT=24
# FUSION_MODEL=google/gemini-3.1-pro-preview
# EXTRACTION_MODEL=google/gemini-3-flash-preview
# COMMITTEE_MODEL_A=anthropic/claude-opus-4.6
# COMMITTEE_MODEL_B=google/gemini-3.1-pro-preview
# COMMITTEE_MODEL_C=openai/gpt-5.4
# EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# PRECHECK_VISION_MODEL=google/gemini-3.1-flash-lite
# PRECHECK_VISION_FALLBACK=google/gemini-3.5-flash
# DOCUMENT_OCR_MAX_WORKERS=3
# DOCUMENT_OCR_PAGE_DPI=180
# DOCUMENT_OCR_PAGE_SLICE_THRESHOLD=3600
# DOCUMENT_OCR_REQUEST_TIMEOUT_SECONDS=120
# DOCUMENT_OCR_MAX_RETRIES=2
# DOCUMENT_OCR_MAX_TOKENS=8000
# DOCUMENT_OCR_REASONING_EFFORT=none
# DOCUMENT_OCR_FALLBACK_REASONING_EFFORT=minimal
# DOCUMENT_PDF_OCR_MODEL=google/gemini-3.5-flash
# DOCUMENT_PDF_OCR_FALLBACK_MODEL=google/gemini-3.1-flash-lite
# DOCUMENT_PDF_OCR_REASONING_EFFORT=minimal
# DOCUMENT_PDF_OCR_FALLBACK_REASONING_EFFORT=none
# DOCUMENT_HYBRID_MIN_VISUAL_COVERAGE=0.15
# DOCUMENT_HYBRID_MIN_DRAWING_COUNT=50
# DOCUMENT_HYBRID_SKIP_DECORATIVE_EDGE_PAIR=true

# ── 网络代理（国内环境必须）──────────────────────────────────
# 国内直连外部 API（Binance/CoinGecko/Yahoo/OpenRouter）会超时
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── 外部数据源 API Keys ──────────────────────────────────────
# CoinGecko Demo Key — 免费注册：https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
# FRED 宏观数据 Key — 免费注册：https://fredaccount.stlouisfed.org/apikey
FRED_API_KEY=
# Alpha Vantage Key — 免费注册：https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── 社交媒体（可选）───────────────────────────────────────
RSSHUB_BASE_URL=http://localhost:1200
MEDIACRAWLER_API_URL=http://localhost:8080
WEMPRSS_BASE_URL=http://localhost:8090

# Cookie（在 Settings 界面更新更方便）
TWITTER_COOKIE=
WEIBO_COOKIE=
XHS_COOKIE=
DOUYIN_COOKIE=

# 追踪博主（逗号分隔）
SOCIAL_TWITTER_ACCOUNTS=
SOCIAL_WEIBO_UIDS=
SOCIAL_XHS_USER_IDS=
SOCIAL_DOUYIN_USER_IDS=
SOCIAL_WECHAT_ACCOUNTS=

# 抖音视频转写（Google AI Studio 免费 1500次/天）
GOOGLE_AI_API_KEY=

# ── 对象存储（MinIO，可选）────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-files

# ── 应用配置 ─────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret
APP_CORS_ORIGINS=["http://localhost:5173"]

# Local/demo ingestion queue. Production must use the durable Celery mode.
INGESTION_DISPATCHER_MODE=auto
INGESTION_ASYNC_MAX_WORKERS=2
INGESTION_ASYNC_MAX_OUTSTANDING=50
INGESTION_MAX_ACTIVE_JOBS=100
INGESTION_RESERVATION_TTL_SECONDS=30
CELERY_BROKER_URL=
CELERY_INGESTION_QUEUE=ingestion
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_VISIBILITY_TIMEOUT_SECONDS=4200
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TASK_TIME_LIMIT_SECONDS=3600

# ── 功能开关（Mock 模式）────────────────────────────────────
# true  = 从数据库读取 mock 数据，不调用真实 API
# false = 调用真实外部 API（需配置对应 API Key + 代理）
USE_MOCK_EVENT_FEED=false
USE_MOCK_MARKET_DATA=false
USE_MOCK_FLOW_DATA=false

# ── 模型调用参数（高级，通常无需修改）─────────────────────────
MAX_TOKENS_PER_REQUEST=4096
LLM_TEMPERATURE=0.2
