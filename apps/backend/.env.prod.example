# ============================================================
# ThinkRoom production environment template
# ------------------------------------------------------------
# Copy to a private deployment secret source or SOPS-managed env file.
# Never commit filled values. Validate with:
#   python scripts/validate_production_env.py --env-file <your-env-file> --fail-on-error
# ============================================================

# ---- Runtime profile ---------------------------------------
APP_ENV=production
DEPLOYMENT_CONFIG_ID=<REQUIRED_RELEASE_CONFIG_ID>
APP_DEBUG=false
OPENROUTER_MOCK=false
# Secret provenance metadata required by production release gates.
# Use the controlled secret source that injects this env file, for example:
#   sops:production, vault:research-os, kubernetes-secret:research-os
SECRETS_SOURCE=sops:production
DATABASE_URL_SOURCE=sops:DATABASE_URL
REDIS_URL_SOURCE=sops:REDIS_URL
MINIO_ENDPOINT_SOURCE=sops:MINIO_ENDPOINT
MINIO_ACCESS_KEY_SOURCE=sops:MINIO_ACCESS_KEY
MINIO_SECRET_KEY_SOURCE=sops:MINIO_SECRET_KEY

# ---- Database ----------------------------------------------
# Production must use PostgreSQL/Postgres+pgvector, not SQLite.
DATABASE_URL=<POSTGRES_DSN_FROM_CONTROLLED_SECRET_SOURCE>
PGVECTOR_ENABLED=true
# docker-compose.prod.yml interpolation values. Keep these in the same controlled
# secret source as DATABASE_URL so compose and the release gate validate one file.
POSTGRES_PASSWORD=<REQUIRED_POSTGRES_PASSWORD>

# ---- API authentication and app secrets --------------------
APP_API_KEY=<REQUIRED_STRONG_RANDOM_API_KEY>
APP_SECRET_KEY=<REQUIRED_STRONG_RANDOM_APP_SECRET_AT_LEAST_32_CHARS>

# ---- LLM routing -------------------------------------------
OPENROUTER_API_KEY=<REQUIRED_OPENROUTER_API_KEY>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRECHECK_VISION_MODEL=google/gemini-3.1-flash-lite
PRECHECK_VISION_FALLBACK=google/gemini-3.5-flash
DOCUMENT_OCR_MAX_WORKERS=3
DOCUMENT_OCR_PAGE_DPI=180
DOCUMENT_OCR_PAGE_SLICE_THRESHOLD=3600
DOCUMENT_OCR_REQUEST_TIMEOUT_SECONDS=120
DOCUMENT_OCR_MAX_RETRIES=2
DOCUMENT_OCR_MAX_TOKENS=8000
DOCUMENT_OCR_REASONING_EFFORT=none
DOCUMENT_OCR_FALLBACK_REASONING_EFFORT=minimal
DOCUMENT_PDF_OCR_MODEL=google/gemini-3.5-flash
DOCUMENT_PDF_OCR_FALLBACK_MODEL=google/gemini-3.1-flash-lite
DOCUMENT_PDF_OCR_REASONING_EFFORT=minimal
DOCUMENT_PDF_OCR_FALLBACK_REASONING_EFFORT=none
DOCUMENT_HYBRID_MIN_VISUAL_COVERAGE=0.15
DOCUMENT_HYBRID_MIN_DRAWING_COUNT=50
DOCUMENT_HYBRID_SKIP_DECORATIVE_EDGE_PAIR=true

# ---- Durable ingestion workers -----------------------------
INGESTION_DISPATCHER_MODE=celery
INGESTION_ASYNC_MAX_WORKERS=2
INGESTION_ASYNC_MAX_OUTSTANDING=100
INGESTION_MAX_ACTIVE_JOBS=100
INGESTION_RESERVATION_TTL_SECONDS=30
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_INGESTION_QUEUE=ingestion
CELERY_WORKER_CONCURRENCY=2
# Long-running ingestion invariant: prefetch must remain 1, soft < hard,
# and visibility must be at least hard + 300 seconds.
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_VISIBILITY_TIMEOUT_SECONDS=4200
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TASK_TIME_LIMIT_SECONDS=3600
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=1500000
CELERY_INSPECT_TIMEOUT_SECONDS=1

# ---- Shared state and rate limiting ------------------------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# ---- Object storage ----------------------------------------
OBJECT_STORAGE_PROVIDER=minio
REQUIRE_OBJECT_STORAGE_IN_PRODUCTION=true
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=true
ALLOW_INSECURE_OBJECT_STORAGE_IN_PRODUCTION=false
MINIO_BUCKET=agent-files-prod
MINIO_ACCESS_KEY=<REQUIRED_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<REQUIRED_MINIO_SECRET_KEY>
# docker-compose.prod.yml maps these to the MinIO root account at startup.
MINIO_ROOT_USER=<REQUIRED_MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<REQUIRED_MINIO_ROOT_PASSWORD>

# ---- Observability -----------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO
LOG_DIR=/var/log/researchos
LOG_RETENTION_DAYS=30
SENTRY_DSN=<REQUIRED_SENTRY_DSN_OR_DOCUMENTED_ALTERNATIVE>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---- CORS --------------------------------------------------
APP_CORS_ORIGINS=["https://your-production-domain.example"]

# ---- Optional market and social data sources ---------------
COINGECKO_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
TAVILY_API_KEY=
GOOGLE_AI_API_KEY=

RSSHUB_BASE_URL=
MEDIACRAWLER_API_URL=
WEMPRSS_BASE_URL=
TWITTER_COOKIE=
WEIBO_COOKIE=
XHS_COOKIE=
DOUYIN_COOKIE=
